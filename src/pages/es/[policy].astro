---
import PolicyPage from "../../components/editorial/PolicyPage.astro";
import type { PolicyKind } from "../../data/policies";

export function getStaticPaths() {
  return [
    { params: { policy: "aviso-legal" }, props: { kind: "legal" } },
    { params: { policy: "privacidad" }, props: { kind: "privacy" } },
    { params: { policy: "accesibilidad" }, props: { kind: "accessibility" } },
  ];
}
const { kind } = Astro.props as { kind: PolicyKind };
---
<PolicyPage locale="es" kind={kind} />
