---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PatternChart from "./PatternChart.astro";
import type { HomeLocale } from "../../data/home";
import { monthLabels, whenContent } from "../../data/when";
import { hourlyPattern, monthlyPattern, settingPattern, temporalSampleSize } from "../../data/temporal";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = whenContent[locale];
const hourLabels = Array.from({ length: 24 }, (_, hour) => `${String(hour).padStart(2, "0")}:00`);
const sharePercent = (rows: typeof hourlyPattern) => rows.map((row) => row.share * 100);
const boundPercent = (rows: typeof hourlyPattern, bound: "lower" | "upper") => rows.map((row) => row[bound]! * 100);
const strongestWindow = (rows: typeof hourlyPattern) => Array.from({ length: rows.length }, (_, start) => ({
  start,
  share: Array.from({ length: 3 }, (_, offset) => rows[(start + offset) % rows.length].share).reduce((sum, value) => sum + value, 0),
})).toSorted((a, b) => b.share - a.share)[0];
const hourWindow = strongestWindow(hourlyPattern);
const monthWindow = strongestWindow(monthlyPattern);
const highlightedHours = Array.from({ length: 3 }, (_, offset) => (hourWindow.start + offset) % 24);
const highlightedMonths = Array.from({ length: 3 }, (_, offset) => (monthWindow.start + offset) % 12);
const monthNames = Array.from({ length: 12 }, (_, index) => new Intl.DateTimeFormat({ en: "en-GB", es: "es-ES", ca: "ca-ES" }[locale], { month: "long" }).format(new Date(2025, index, 1)));
const hourTakeaway = copy.hour.takeaway.replace("{value}", String(Math.round(hourWindow.share * 100))).replace("{start}", hourLabels[hourWindow.start]).replace("{end}", hourLabels[(hourWindow.start + 3) % 24]);
const monthTakeaway = copy.month.takeaway.replace("{value}", String(Math.round(monthWindow.share * 100))).replace("{start}", monthNames[monthWindow.start]).replace("{end}", monthNames[(monthWindow.start + 2) % 12]);
const localizedPercent = new Intl.NumberFormat({ en: "en-GB", es: "es-ES", ca: "ca-ES" }[locale], { maximumFractionDigits: 1 });
---

<BaseLayout locale={locale} title={copy.metaTitle} description={copy.metaDescription}>
  <div class="wrap page when-page">
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      <span class="demo-tag">{copy.badge}</span>
      <p class="source-note">{copy.sourceNote}</p>
    </header>

    <div class="story-layout">
      <PatternChart locale={locale} id="hour" {...copy.hour} takeaway={hourTakeaway} labels={hourLabels} values={sharePercent(hourlyPattern)} lowerValues={boundPercent(hourlyPattern, "lower")} upperValues={boundPercent(hourlyPattern, "upper")} labelEvery={3} highlight={highlightedHours} badge={copy.badge} dataLabel={copy.dataLabel} tableSummary={copy.tableSummary} tableCaption={copy.tableCaption} tableValue={copy.tableValue} lower={copy.lower} upper={copy.upper} sourceNote={copy.sourceNote} scrollHint={copy.scrollHint} />
      <PatternChart locale={locale} id="month" {...copy.month} takeaway={monthTakeaway} labels={monthLabels[locale]} values={sharePercent(monthlyPattern)} lowerValues={boundPercent(monthlyPattern, "lower")} upperValues={boundPercent(monthlyPattern, "upper")} highlight={highlightedMonths} badge={copy.badge} dataLabel={copy.dataLabel} tableSummary={copy.tableSummary} tableCaption={copy.tableCaption} tableValue={copy.tableValue} lower={copy.lower} upper={copy.upper} sourceNote={copy.sourceNote} scrollHint={copy.scrollHint} />
      <section class="setting" aria-labelledby="setting-heading">
        <div><p class="eyebrow">{copy.eyebrow}</p><h2 id="setting-heading">{copy.settingTitle}</h2><p>{copy.settingIntro}</p><p class="source-note">{copy.sample}: {temporalSampleSize.toLocaleString({ en: "en-GB", es: "es-ES", ca: "ca-ES" }[locale])}. {copy.sourceNote}</p></div>
        <table><caption>{copy.settingTitle}</caption><thead><tr><th scope="col">{copy.settingTitle}</th><th scope="col">{copy.tableValue}</th></tr></thead><tbody>{settingPattern.map((row) => <tr><th scope="row">{copy.settingLabels[row.category as "outdoor" | "indoor"]}</th><td>{localizedPercent.format(row.share * 100)}%</td></tr>)}</tbody></table>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page-head{display:grid;justify-items:start;gap:14px;max-width:850px;margin-bottom:42px}.page-head h1{font-size:clamp(2.55rem,4.7vw,4.55rem)}.source-note{color:var(--ink-3);font-size:.84rem}.story-layout{display:grid;gap:72px}.setting{display:grid;grid-template-columns:minmax(220px,.36fr) minmax(0,.64fr);gap:54px;padding-top:24px;border-top:1px solid var(--line)}.setting h2{font-size:clamp(1.65rem,2.7vw,2.5rem)}.setting p:not(.eyebrow){color:var(--ink-2);font-size:.91rem;margin-top:12px}.setting table{width:100%;border-collapse:collapse;align-self:start}.setting caption{text-align:left;padding-bottom:12px;font-weight:700}.setting th,.setting td{padding:12px;border-top:1px solid var(--line);text-align:left}.setting td{text-align:right;font-variant-numeric:tabular-nums}
  @media(max-width:1000px){.setting{grid-template-columns:1fr;gap:22px}}
  @media(max-width:600px){.story-layout{gap:56px}.page-head h1{font-size:clamp(2.4rem,12vw,3.5rem)}}
</style>
