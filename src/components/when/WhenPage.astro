---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PatternChart from "./PatternChart.astro";
import type { HomeLocale } from "../../data/home";
import { hourlyShares, monthlyShares, monthLabels, whenContent } from "../../data/when";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = whenContent[locale];
const hourLabels = Array.from({ length: 24 }, (_, hour) => `${String(hour).padStart(2, "0")}:00`);
---

<BaseLayout locale={locale} title={copy.metaTitle} description={copy.metaDescription}>
  <div class="wrap page when-page">
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      <span class="demo-tag">{copy.badge}</span>
      <p class="source-note">{copy.sourceNote}</p>
    </header>

    <div class="story-layout">
      <PatternChart locale={locale} id="hour" {...copy.hour} labels={hourLabels} values={hourlyShares} labelEvery={3} highlight={[18, 19, 20]} badge={copy.badge} dataLabel={copy.dataLabel} tableSummary={copy.tableSummary} tableCaption={copy.tableCaption} tableValue={copy.tableValue} sourceNote={copy.sourceNote} scrollHint={copy.scrollHint} />
      <PatternChart locale={locale} id="month" {...copy.month} labels={monthLabels[locale]} values={monthlyShares} highlight={[6, 7, 8]} badge={copy.badge} dataLabel={copy.dataLabel} tableSummary={copy.tableSummary} tableCaption={copy.tableCaption} tableValue={copy.tableValue} sourceNote={copy.sourceNote} scrollHint={copy.scrollHint} />
    </div>
  </div>
</BaseLayout>

<style>
  .page-head{display:grid;justify-items:start;gap:14px;max-width:850px;margin-bottom:42px}.page-head h1{font-size:clamp(2.55rem,4.7vw,4.55rem)}.source-note{color:var(--ink-3);font-size:.84rem}.story-layout{display:grid;gap:72px}
  @media(max-width:600px){.story-layout{gap:56px}.page-head h1{font-size:clamp(2.4rem,12vw,3.5rem)}}
</style>
