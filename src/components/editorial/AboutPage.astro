---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { HomeLocale } from "../../data/home";
import { aboutContent } from "../../data/about";
import { publications } from "../../data/publications";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = aboutContent[locale];
const projectUrl = locale === "es" ? "https://h-mip.com/es/" : "https://h-mip.com/en/";
const resultsUrl = locale === "es" ? "https://cordis.europa.eu/project/id/853271/results/es" : "https://cordis.europa.eu/project/id/853271/results";
---

<BaseLayout locale={locale} title={copy.metaTitle} description={copy.metaDescription}>
  <div class="wrap page about-page">
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
    </header>

    <div class="about-grid">
      <nav class="about-nav" aria-label={copy.sectionsLabel}>
        <a href="#project">{copy.nav.project}</a>
        <a href="#methods">{copy.nav.methods}</a>
        <a href="#team">{copy.nav.team}</a>
        <a href="#publications">{copy.nav.publications}</a>
      </nav>

      <div class="about-copy">
        <section class="about-section" id="project" aria-labelledby="project-title">
          <p class="eyebrow">{copy.nav.project}</p>
          <h2 id="project-title">{copy.project.title}</h2>
          {copy.project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href={projectUrl} target="_blank" rel="noopener noreferrer">{copy.project.link} <span aria-hidden="true">↗</span></a>
        </section>

        <section class="about-section" id="methods" aria-labelledby="methods-title">
          <p class="eyebrow">{copy.nav.methods}</p>
          <h2 id="methods-title">{copy.methods.title}</h2>
          <p>{copy.methods.intro}</p>
          <div class="method-list">
            {copy.methods.steps.map((step, index) => <article class="method">
              <span class="method-number">{String(index + 1).padStart(2, "0")}</span>
              <div><h3>{step.title}</h3><p>{step.text}</p></div>
            </article>)}
          </div>
        </section>

        <section class="about-section" id="team" aria-labelledby="team-title">
          <p class="eyebrow">{copy.nav.team}</p>
          <h2 id="team-title">{copy.team.title}</h2>
          <p>{copy.team.intro}</p>
          <div class="institution-list">
            {copy.team.institutions.map((institution) => <div class="institution">
              <strong>{institution.name}</strong>
              <span>{institution.detail}</span>
            </div>)}
          </div>
          <p class="fine">{copy.team.note}</p>
        </section>

        <section class="about-section" id="publications" aria-labelledby="publications-title">
          <p class="eyebrow">{copy.nav.publications}</p>
          <h2 id="publications-title">{copy.publications.title}</h2>
          <p>{copy.publications.text}</p>
          <div class="publication-list">
            {publications.map((publication) => <article class="publication">
              <div class="publication-meta"><span>{publication.year}</span><span>{publication.type === "preprint" ? copy.publications.preprint : copy.publications.article}</span><span>{publication.venue}</span></div>
              <h3>{publication.title}</h3>
              <p class="publication-authors">{publication.authors}</p>
              <div class="publication-links">
                <a href={publication.url} target="_blank" rel="noopener noreferrer">{copy.publications.openPublication} <span aria-hidden="true">↗</span></a>
                {publication.openAccessUrl !== publication.url && <a href={publication.openAccessUrl} target="_blank" rel="noopener noreferrer">{copy.publications.openAccess} <span aria-hidden="true">↗</span></a>}
                <span>DOI: {publication.doi}</span>
              </div>
            </article>)}
          </div>
          <a class="text-link" href={resultsUrl} target="_blank" rel="noopener noreferrer">{copy.publications.link} <span aria-hidden="true">↗</span></a>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-head{display:grid;gap:14px;max-width:860px;margin-bottom:62px}
  .page-head h1{font-size:clamp(2.55rem,4.8vw,4.6rem)}
  .about-grid{display:grid;grid-template-columns:195px minmax(0,1fr);gap:clamp(34px,6vw,96px)}
  .about-nav{position:sticky;top:calc(var(--header-height) + 24px);align-self:start;display:grid;gap:2px;padding-left:14px;border-left:2px solid var(--line)}
  .about-nav a{padding:8px 10px;color:var(--ink-2);font-size:.88rem;font-weight:650;text-decoration:none}
  .about-nav a:hover{background:var(--surface-soft);color:var(--ink)}
  .about-copy{min-width:0;max-width:790px}
  .about-section{display:grid;gap:17px;padding:0 0 60px;margin-bottom:54px;border-bottom:1px solid var(--line);scroll-margin-top:calc(var(--header-height) + 28px)}
  .about-section:last-child{margin-bottom:0;border-bottom:0}
  .about-section h2{font-size:clamp(1.9rem,3.2vw,2.75rem)}
  .about-section>p:not(.eyebrow){max-width:68ch;color:var(--ink-2)}
  .text-link{width:max-content;max-width:100%;font-weight:700}
  .method-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:9px}
  .method{display:grid;grid-template-columns:30px 1fr;gap:10px;align-content:start;min-height:116px;padding:18px;background:var(--surface);border:1px solid var(--line);border-radius:8px}
  .method-number{padding-top:3px;color:var(--teal);font:650 .72rem var(--mono)}
  .method h3{margin-bottom:5px;font:650 1.1rem/1.3 var(--serif)}
  .method p{color:var(--ink-2);font-size:.86rem}
  .institution-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:8px}
  .institution{display:grid;align-content:start;gap:8px;min-height:117px;padding:18px;background:var(--surface);border:1px solid var(--line);border-radius:8px}
  .institution strong{font-size:.9rem;line-height:1.35}.institution span{color:var(--ink-3);font-size:.78rem}
  .about-section>.fine{font-size:.82rem;color:var(--ink-3)}
  .publication-list{display:grid;margin-top:10px;border-top:2px solid var(--ink)}
  .publication{display:grid;gap:8px;padding:20px 0;border-bottom:1px solid var(--line)}
  .publication h3{font:650 1.13rem/1.3 var(--serif)}
  .publication-meta,.publication-links{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:baseline;font-size:.78rem}
  .publication-meta{color:var(--ink-3);font-family:var(--mono)}
  .publication-authors{color:var(--ink-2);font-size:.85rem}
  .publication-links a{font-weight:700}
  .publication-links>span{color:var(--ink-3);overflow-wrap:anywhere}
  @media(max-width:820px){.about-grid{grid-template-columns:1fr;gap:34px}.about-nav{position:static;display:flex;flex-wrap:wrap;gap:4px;padding:0 0 12px;border-left:0;border-bottom:1px solid var(--line)}}
  @media(max-width:600px){.page-head{margin-bottom:40px}.method-list,.institution-list{grid-template-columns:1fr}.method,.institution{min-height:0}.about-section{padding-bottom:46px;margin-bottom:42px}}
</style>
