---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { HomeLocale } from "../../data/home";
import { dataPageContent } from "../../data/dataPage";
import { researchOutputs, type OutputKind } from "../../data/outputs";
import { internalUrl } from "../../utils/urls";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = dataPageContent[locale];
const kinds: OutputKind[] = (["dataset", "code", "other"] as OutputKind[]).filter((kind) => researchOutputs.some((output) => output.kind === kind));
const projectUrl = locale === "es" ? "https://h-mip.com/es/" : "https://h-mip.com/en/";
const resultsUrl = locale === "es" ? "https://cordis.europa.eu/project/id/853271/results/es" : "https://cordis.europa.eu/project/id/853271/results";
const extra = {
  en: { source: "Website source code", sourceText: "The site's source code and update guide are available on GitHub under GPL-3.0.", credits: "Municipal and comarca boundaries © ICGC, CC BY 4.0. Basemap © OpenStreetMap contributors (ODbL)." },
  es: { source: "Código fuente del sitio", sourceText: "El código y la guía de actualización están en GitHub bajo GPL-3.0.", credits: "Límites municipales y comarcales © ICGC, CC BY 4.0. Mapa base © colaboradores de OpenStreetMap (ODbL)." },
  ca: { source: "Codi font del lloc", sourceText: "El codi i la guia d'actualització són a GitHub sota GPL-3.0.", credits: "Límits municipals i comarcals © ICGC, CC BY 4.0. Mapa base © col·laboradors d'OpenStreetMap (ODbL)." },
}[locale];
---

<BaseLayout locale={locale} title={copy.metaTitle} description={copy.metaDescription}>
  <div class="wrap page data-page">
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
    </header>

    {researchOutputs.length === 0 && <section class="catalogue-status" aria-labelledby="catalogue-status-title">
      <p class="eyebrow">{copy.statusEyebrow}</p>
      <h2 id="catalogue-status-title">{copy.statusTitle}</h2>
      <p>{copy.statusText}</p>
    </section>}

    <div class="catalogue">
      {kinds.map((kind, index) => {
        const entries = researchOutputs.filter((output) => output.kind === kind);
        return <section class="catalogue-group" aria-labelledby={`${kind}-title`}>
          <div class="group-heading"><p class="eyebrow">{String(index + 1).padStart(2, "0")}</p><h2 id={`${kind}-title`}>{copy.groups[kind]}</h2></div>
          <div class="outputs">
            {entries.length === 0 && <p class="empty">{copy.empty}</p>}
            {entries.map((output) => <article class="output">
              <div class="output-meta"><span>{output.host}</span>{output.year && <span>{output.year}</span>}{output.license && <span>{output.license}</span>}</div>
              <h3>{output.title[locale]}</h3>
              <p>{output.description[locale]}</p>
              <a href={output.doi ? `https://doi.org/${output.doi}` : output.url} target="_blank" rel="noopener noreferrer">{output.doi ? `DOI: ${output.doi}` : copy.openResource} <span aria-hidden="true">↗</span></a>
            </article>)}
          </div>
        </section>;
      })}
    </div>

    <section class="resource-section" aria-labelledby="resources-title">
      <div class="section-intro"><p class="eyebrow">{copy.resourcesEyebrow}</p><h2 id="resources-title">{copy.resourcesTitle}</h2><p>{copy.resourcesIntro}</p></div>
      <div class="resource-grid">
        <article><h3>{copy.projectSite}</h3><p>{copy.projectSiteText}</p><a href={projectUrl} target="_blank" rel="noopener noreferrer">{copy.projectSite} <span aria-hidden="true">↗</span></a></article>
        <article><h3>{copy.euResults}</h3><p>{copy.euResultsText}</p><a href={resultsUrl} target="_blank" rel="noopener noreferrer">{copy.euResults} <span aria-hidden="true">↗</span></a></article>
        <article><h3>{extra.source}</h3><p>{extra.sourceText}</p><a href="https://github.com/h-mip/explore" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></article>
      </div>
    </section>

    <section class="site-data" aria-labelledby="site-data-title">
      <p class="eyebrow">{copy.siteEyebrow}</p>
      <h2 id="site-data-title">{copy.siteTitle}</h2>
      <p>{copy.siteText}</p>
      <p>{extra.credits}</p>
      <div class="draft-downloads" id="draft-downloads">
        <h3>{copy.downloadTitle}</h3>
        <p>{copy.downloadIntro}</p>
        <ul>
          <li><a href={internalUrl("data/layer_h3.csv")} download>{copy.h3Download}</a></li>
          <li><a href={internalUrl("data/layer_municipality.csv")} download>{copy.municipalityDownload}</a></li>
          <li><a href={internalUrl("data/layers.csv")} download>{copy.metadataDownload}</a></li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head{display:grid;gap:14px;max-width:800px;margin-bottom:42px}.page-head h1{font-size:clamp(2.55rem,4.7vw,4.55rem)}
  .catalogue-status{display:grid;gap:10px;max-width:760px;padding:24px;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:8px}.catalogue-status h2{font-size:clamp(1.45rem,2.3vw,2rem)}.catalogue-status p:last-child{color:var(--ink-2)}
  .catalogue{display:grid;gap:52px;margin-top:52px}.catalogue-group{display:grid;grid-template-columns:190px 1fr;gap:34px;padding-top:14px;border-top:2px solid var(--ink)}.group-heading h2{font-size:1.65rem;margin-top:5px}.outputs{display:grid;min-width:0}.empty{padding:5px 0 18px;color:var(--ink-3);font-size:.91rem}
  .output{display:grid;gap:7px;padding:4px 0 20px}.output+.output{border-top:1px solid var(--line);padding-top:18px}.output-meta{display:flex;gap:12px;flex-wrap:wrap;color:var(--ink-3);font:650 .7rem var(--mono);letter-spacing:.05em;text-transform:uppercase}.output h3{font:650 1.22rem/1.3 var(--serif)}.output p{max-width:70ch;color:var(--ink-2);font-size:.91rem}.output a{font-weight:700;font-size:.84rem}
  .resource-section,.site-data{display:grid;gap:18px;margin-top:72px;padding-top:24px;border-top:2px solid var(--ink)}.section-intro{display:grid;gap:8px;max-width:720px}.section-intro p:last-child,.site-data p:last-child{color:var(--ink-2)}.resource-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.resource-grid article{display:grid;gap:10px;align-content:start;padding:22px;background:var(--surface);border:1px solid var(--line);border-radius:9px}.resource-grid h3{font:650 1.35rem/1.25 var(--serif)}.resource-grid p{color:var(--ink-2);font-size:.91rem}.resource-grid a{align-self:end;font-weight:700;font-size:.84rem}.site-data{max-width:760px}.site-data h2{font-size:2rem}
  .draft-downloads{display:grid;gap:10px;margin-top:12px;padding:20px;border:1px solid var(--line);border-radius:9px;background:var(--surface);scroll-margin-top:calc(var(--header-height) + 20px)}.draft-downloads h3{font:650 1.25rem/1.25 var(--serif)}.draft-downloads ul{display:grid;gap:8px;padding-left:20px}.draft-downloads a{font-size:.9rem;font-weight:700}
  @media(max-width:820px){.catalogue-group{grid-template-columns:1fr;gap:14px}}
  @media(max-width:600px){.resource-grid{grid-template-columns:1fr}.page-head h1{font-size:clamp(2.4rem,12vw,3.5rem)}}
</style>
