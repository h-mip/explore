---
import { internalUrl, routes, type Locale } from "../../utils/urls";
import { getCollection } from "astro:content";
import { siteSettings } from "../../data/siteSettings";
import { isPublishedStory } from "../../data/stories";
interface Props { locale: Locale }
const { locale } = Astro.props;

const content = {
  en: {
    project: "A project by",
    funded: "Funded by",
    fundingText: "This project has received funding from the European Research Council (ERC) under the European Union's Horizon 2020 research and innovation programme (grant agreement No 853271). The content of this website represents the views of the author only and is his sole responsibility. The European Commission does not accept any responsibility for the use that may be made of the information it contains.",
    attribution: "Municipal and comarca boundaries © ICGC, CC BY 4.0. Basemap © OpenStreetMap contributors (ODbL).",
    explore: "Explore this site",
    home: "Home",
    map: "Map explorer",
    when: "When bites happen",
    activities: "Activities & places",
    data: "Data & Code",
    about: "About H-MIP",
    stories: "Stories",
    legal: "Legal notice", privacy: "Privacy", accessibility: "Accessibility",
    links: "Project links",
    projectSite: "H-MIP project website",
    grant: "EU grant record",
    note: "This site provides research information, not medical advice.",
  },
  es: {
    project: "Un proyecto de",
    funded: "Financiado por",
    fundingText: "Este proyecto ha recibido financiación del Consejo Europeo de Investigación (ERC) en el marco del programa de investigación e innovación Horizonte 2020 de la Unión Europea (acuerdo de subvención n.º 853271). El contenido de este sitio web representa únicamente las opiniones del autor, que es su único responsable. La Comisión Europea no acepta ninguna responsabilidad por el uso que pueda hacerse de la información que contiene.",
    attribution: "Límites municipales y comarcales © ICGC, CC BY 4.0. Mapa base © colaboradores de OpenStreetMap (ODbL).",
    explore: "Explora este sitio",
    home: "Inicio",
    map: "Explorador del mapa",
    when: "Cuándo ocurren las picaduras",
    activities: "Actividades y lugares",
    data: "Datos y código",
    about: "Sobre H-MIP",
    stories: "Historias",
    legal: "Aviso legal", privacy: "Privacidad", accessibility: "Accesibilidad",
    links: "Enlaces del proyecto",
    projectSite: "Sitio web del proyecto H-MIP",
    grant: "Ficha de la subvención de la UE",
    note: "Este sitio ofrece información de investigación, no asesoramiento médico.",
  },
  ca: {
    project: "Un projecte de",
    funded: "Finançat per",
    fundingText: "Aquest projecte ha rebut finançament del Consell Europeu de Recerca (ERC) en el marc del programa de recerca i innovació Horitzó 2020 de la Unió Europea (acord de subvenció núm. 853271). El contingut d'aquest web representa únicament les opinions de l'autor, que n'és l'únic responsable. La Comissió Europea no accepta cap responsabilitat per l'ús que es pugui fer de la informació que conté.",
    attribution: "Límits municipals i comarcals © ICGC, CC BY 4.0. Mapa base © col·laboradors d'OpenStreetMap (ODbL).",
    explore: "Explora aquest lloc",
    home: "Inici",
    map: "Explorador del mapa",
    when: "Quan es produeixen les picades",
    activities: "Activitats i llocs",
    data: "Dades i codi",
    about: "Sobre H-MIP",
    stories: "Històries",
    legal: "Avís legal", privacy: "Privacitat", accessibility: "Accessibilitat",
    links: "Enllaços del projecte",
    projectSite: "Lloc web del projecte H-MIP",
    grant: "Fitxa de la subvenció de la UE",
    note: "Aquest lloc ofereix informació de recerca, no assessorament mèdic.",
  },
} as const;

const copy = content[locale];
const links = routes[locale];
const hasStories = (await getCollection("stories", (entry) => isPublishedStory(entry) && entry.data.locale === locale)).length > 0;
const projectUrl = locale === "es" ? "https://h-mip.com/es/" : "https://h-mip.com/en/";
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-identity">
      <div class="identity-group">
        <span class="identity-label">H-MIP</span>
        <span class="wordmark"><img src={internalUrl("logos/hmip-logo-white.png")} alt="H-MIP" width="290" height="116" /><em>{locale === "en" ? "Explore" : "Explora"}</em></span>
      </div>
      <div class="identity-group">
        <span class="identity-label">{copy.project}</span>
        <div class="logo-line"><img src={internalUrl("logos/upf-logo-white.png")} alt="Universitat Pompeu Fabra" /><img src={internalUrl("logos/ceab-logo-exploring-aquatic-ecosystems.png")} alt="CEAB-CSIC" /></div>
      </div>
      <div class="identity-group">
        <span class="identity-label">{copy.funded}</span>
        <div class="logo-line"><img src={internalUrl("logos/erc-logo.png")} alt="European Research Council" /><img src={internalUrl("logos/eu-emblem.svg")} alt={locale === "en" ? "European Union" : locale === "es" ? "Unión Europea" : "Unió Europea"} /></div>
      </div>
    </div>

    <div class="footer-grid">
      <div class="funding-copy"><p class="funding-text">{copy.fundingText}</p><p>{copy.attribution}</p></div>
      <nav class="footer-links" aria-label={copy.explore}>
        <strong>{copy.explore}</strong>
        <a href={links.home}>{copy.home}</a>
        <a href={links.map}>{copy.map}</a>
        {siteSettings.showSurveyResults && <a href={links.when}>{copy.when}</a>}
        {siteSettings.showSurveyResults && <a href={links.activities}>{copy.activities}</a>}
        <a href={links.data}>{copy.data}</a>
        <a href={links.about}>{copy.about}</a>
        {hasStories && <a href={links.stories}>{copy.stories}</a>}
        <a href={links.legal}>{copy.legal}</a>
        <a href={links.privacy}>{copy.privacy}</a>
        <a href={links.accessibility}>{copy.accessibility}</a>
      </nav>
      <nav class="footer-links" aria-label={copy.links}>
        <strong>{copy.links}</strong>
        <a href={projectUrl} target="_blank" rel="noopener noreferrer">{copy.projectSite} <span aria-hidden="true">↗</span></a>
        <a href="https://cordis.europa.eu/project/id/853271" target="_blank" rel="noopener noreferrer">{copy.grant} <span aria-hidden="true">↗</span></a>
      </nav>
    </div>

    <div class="footer-bottom"><span>H-MIP {locale === "en" ? "Explore" : "Explora"}</span><span>{copy.note}</span></div>
  </div>
</footer>

<style>
  .site-footer{background:var(--surface);border-top:1px solid var(--line)}
  .footer-inner{display:grid;gap:28px;padding-block:38px 46px;color:var(--ink-2);font-size:.83rem}
  .footer-identity{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:34px;padding-bottom:24px;border-bottom:1px solid var(--line)}
  .identity-group{display:grid;gap:9px;align-content:start}.identity-label{font:650 .66rem var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--ink-3)}
  .wordmark{display:inline-flex;align-items:center;gap:9px;color:var(--ink)}.wordmark img{display:block;width:auto;height:31px}.wordmark em{font:italic 650 1.2rem var(--serif);color:var(--teal)}
  .logo-line{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.logo-line img{display:block;max-width:150px;max-height:48px;width:auto;height:auto;object-fit:contain}
  .footer-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(140px,.6fr) minmax(160px,.8fr);gap:34px}.funding-copy{display:grid;gap:14px;align-content:start;max-width:70ch}.footer-links{display:grid;gap:7px;align-content:start}.footer-links strong{color:var(--ink);font-size:.79rem}.footer-links a{color:var(--ink-2)}
  .footer-bottom{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:18px;border-top:1px solid var(--line);font-size:.78rem;color:var(--ink-3)}
  @media(max-width:820px){.footer-identity{grid-template-columns:1fr 1fr}.identity-group:first-child{grid-column:1/-1}.footer-grid{grid-template-columns:1fr 1fr}.funding-copy{grid-column:1/-1}}
  @media(max-width:600px){.footer-identity,.footer-grid{grid-template-columns:1fr}.identity-group:first-child,.funding-copy{grid-column:auto}.footer-bottom{display:grid}}
</style>
