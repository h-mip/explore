---
import { homeContent, type HomeLocale } from "../../data/home";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = homeContent[locale].action;
---

<section class="public-action" aria-labelledby="science-title">
  <div class="science-copy">
    <p class="eyebrow">{copy.scienceEyebrow}</p>
    <h2 id="science-title">{copy.scienceTitle}</h2>
    <p class="science-intro">{copy.scienceText}</p>
  </div>
  <div class="science-actions">
    <ul>{copy.scienceList.map((item) => <li>{item}</li>)}</ul>
    <a class="btn btn-primary" href="https://www.mosquitoalert.com/" target="_blank" rel="noopener noreferrer">{copy.scienceLink} <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .public-action{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:40px;margin-top:88px;padding:34px 0;border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line)}
  .science-copy{display:grid;gap:10px}.science-copy h2{font-size:clamp(1.65rem,2.8vw,2.4rem);max-width:20ch}.science-intro{max-width:58ch;color:var(--ink-2)}
  .science-actions{display:grid;gap:20px;align-content:center}.science-actions ul{list-style:none;padding:0;margin:0;display:grid;gap:9px;color:var(--ink-2);font-size:.92rem}.science-actions li{display:flex;gap:9px;align-items:flex-start}.science-actions li::before{content:"·";font-size:1.5rem;line-height:.75;color:var(--teal)}
  .science-actions .btn{justify-self:start}
  @media(max-width:820px){.public-action{grid-template-columns:1fr;gap:24px}}
</style>
