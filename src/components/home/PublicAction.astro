---
import { homeContent, type HomeLocale } from "../../data/home";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = homeContent[locale].action;
---

<section class="public-action" aria-label={`${copy.preventionEyebrow} · ${copy.scienceEyebrow}`}>
  <div class="protect">
    <p class="eyebrow">{copy.preventionEyebrow}</p>
    <h2>{copy.preventionTitle}</h2>
    <div class="tips">
      {copy.tips.map(([title, detail], index) => <div class="tip"><span class="tip-number">{index + 1}</span><div><strong>{title}</strong><p>{detail}</p></div></div>)}
    </div>
  </div>
  <div class="science">
    <p class="eyebrow">{copy.scienceEyebrow}</p>
    <h2>{copy.scienceTitle}</h2>
    <p class="science-intro">{copy.scienceText}</p>
    <ul>{copy.scienceList.map((item) => <li>{item}</li>)}</ul>
    <a class="btn" href="https://www.mosquitoalert.com/" target="_blank" rel="noopener noreferrer">{copy.scienceLink} <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .public-action{display:grid;grid-template-columns:1.15fr .85fr;margin-top:78px;border:1px solid var(--line);border-radius:12px;overflow:hidden}
  .protect,.science{padding:34px}.protect{background:var(--surface)}.science{background:var(--ink);color:white}
  .protect h2,.science h2{font-size:clamp(1.65rem,2.8vw,2.4rem);margin-top:6px}.science h2{color:white}.science .eyebrow,.science p{color:#c4d0cc}
  .tips{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;margin-top:20px}.tip{padding:13px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:26px 1fr;gap:8px}.tip-number{font:650 1.4rem/1 var(--serif);color:var(--teal)}.tip strong{font-size:.92rem}.tip p{font-size:.84rem;color:var(--ink-2);margin-top:2px}
  .science-intro{margin-top:12px}.science ul{list-style:none;padding:0;margin:18px 0;display:grid;gap:9px;font-size:.92rem}.science li{display:flex;gap:9px;align-items:flex-start}.science li::before{content:"·";font-size:1.5rem;line-height:.75;color:#f0b56e}
  .science .btn{background:white;color:var(--ink)}.science .btn:hover{background:var(--surface-soft)}
  @media(max-width:820px){.public-action{grid-template-columns:1fr}}
  @media(max-width:600px){.tips{grid-template-columns:1fr}.protect,.science{padding:26px 22px}}
</style>
