---
import { demoCharts, homeContent, type HomeLocale } from "../../data/home";
import { routes } from "../../utils/urls";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = homeContent[locale].explore;
const mapPath = routes[locale].map;
const whenPath = routes[locale].when;
const activitiesPath = routes[locale].activities;
const hours = demoCharts.hour.filter((_, index) => index % 2 === 0);
const spatial = [1, 2, 1, 0, 2, 3, 2, 1, 3, 4, 3, 2, 1, 2, 3, 2, 0, 1, 2, 1];
---

<section class="explore-section" id="explore" aria-labelledby="explore-title">
  <div class="section-intro"><p class="eyebrow">{copy.eyebrow}</p><h2 id="explore-title">{copy.title}</h2><p>{copy.intro}</p></div>
  <div class="home-teasers">
    {copy.items.map((item) => <article class="teaser">
      <p class="eyebrow">{item.label}</p>
      <h3>{item.title}</h3>
      <p>{item.text}</p>
      <div class={`teaser-visual visual-${item.chart}`} aria-hidden="true">
        {item.chart === "spatial" && <div class="spatial-cells">{spatial.map((level) => <i class={`level-${level}`}></i>)}</div>}
        {item.chart === "hour" && <div class="hour-bars">{hours.map((value) => <i style={`height:${Math.max(12, value / 43 * 100)}%`}></i>)}</div>}
        {item.chart === "activity" && <div class="activity-bars">{demoCharts.activity.map((value) => <i><span style={`width:${value}%`}></span></i>)}</div>}
      </div>
      <a class="teaser-link" href={item.chart === "spatial" ? mapPath : item.chart === "hour" ? whenPath : activitiesPath}>{item.status} <span aria-hidden="true">→</span></a>
    </article>)}
  </div>
</section>

<style>
  .explore-section{margin-top:88px;scroll-margin-top:calc(var(--header-height) + 52px)}
  .section-intro{display:grid;gap:8px;max-width:720px;margin-bottom:24px}.section-intro p:last-child{color:var(--ink-2)}
  .home-teasers{display:grid;grid-template-columns:1.25fr .8fr .8fr;border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line)}
  .teaser{padding:28px 28px 30px 0;display:grid;gap:12px;align-content:start;min-width:0}.teaser+.teaser{border-left:1px solid var(--line);padding-left:28px}
  .teaser h3{font:650 1.55rem/1.13 var(--serif);letter-spacing:-.02em}.teaser>p:not(.eyebrow):not(.coming-soon){color:var(--ink-2);font-size:.91rem}
  .teaser-visual{height:118px;margin-top:4px}.teaser:first-child .teaser-visual{height:170px}
  .spatial-cells{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;width:100%;height:100%;padding:13px;background:#0b201b;border:1px solid var(--line);border-radius:7px;transform:skewY(-4deg)}
  .spatial-cells i{border-radius:3px;opacity:.94;border:1px solid #0b201b}.level-0{background:var(--q0)}.level-1{background:var(--q1)}.level-2{background:var(--q2)}.level-3{background:var(--q3)}.level-4{background:var(--q4)}
  .hour-bars{height:100%;display:flex;align-items:end;gap:4px;padding:10px 0;border-bottom:1px solid var(--line-strong)}.hour-bars i{flex:1;background:var(--teal);min-width:3px;border-radius:2px 2px 0 0}
  .activity-bars{height:100%;display:grid;align-content:center;gap:11px}.activity-bars i{display:block;height:13px;background:#16332c;border-radius:2px}.activity-bars span{display:block;height:100%;background:var(--teal);border-radius:2px}
  .coming-soon{align-self:end;margin-top:8px;font:650 .71rem/1.4 var(--mono);letter-spacing:.04em;text-transform:uppercase;color:var(--ink-3)}
  .teaser-link{align-self:end;margin-top:8px;color:var(--teal);font-size:.84rem;font-weight:700;text-decoration:none}.teaser-link:hover{color:var(--teal-hover);text-decoration:underline}
  @media(max-width:1100px){.home-teasers{grid-template-columns:1fr 1fr}.teaser:first-child{grid-column:1/-1;border-bottom:1px solid var(--line)}.teaser:nth-child(2){border-left:0;padding-left:0}}
  @media(max-width:600px){.home-teasers{grid-template-columns:1fr}.teaser,.teaser+.teaser{padding:24px 0;border-left:0;border-bottom:1px solid var(--line)}.teaser:last-child{border-bottom:0}}
</style>
