---
import { homeContent, type HomeLocale } from "../../data/home";
import { demoCells, demoPlaces, levelForScore, outlinePoints, scoreForBase } from "../../data/map";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = homeContent[locale].hero;

const mapPath = { en: "/en/map/", es: "/es/mapa/", ca: "/ca/mapa/" }[locale];
const whenPath = { en: "/en/when/", es: "/es/cuando/", ca: "/ca/quan/" }[locale];
const actionLabels = {
  en: { map: "Explore the map", when: "When bites happen" },
  es: { map: "Explorar el mapa", when: "Cuándo ocurren las picaduras" },
  ca: { map: "Explora el mapa", when: "Quan es produeixen les picades" },
}[locale];
const regionLabel = { en: "CATALONIA", es: "CATALUÑA", ca: "CATALUNYA" }[locale];
const figureLabel = { en: "Fig. 1 · Synthetic", es: "Fig. 1 · Sintético", ca: "Fig. 1 · Sintètic" }[locale];
const keyPlaces = demoPlaces.filter((place) => ["lleida", "girona", "barcelona", "tarragona"].includes(place.id));
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="hero-copy">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="home-title">{copy.title}</h1>
    <p class="lead">{copy.lead}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={mapPath}><span aria-hidden="true">▧</span>{actionLabels.map}</a>
      <a class="btn btn-secondary" href={whenPath}><span aria-hidden="true">◷</span>{actionLabels.when}</a>
    </div>
  </div>

  <figure class="map-figure" aria-labelledby="hero-visual-caption">
    <div class="map-frame" aria-hidden="true">
      <svg viewBox="80 45 820 510" preserveAspectRatio="xMidYMid meet">
        <rect x="80" y="45" width="820" height="510" rx="8" class="map-bg" />
        <polygon points={outlinePoints} class="region-fill" />
        <g>
          {demoCells.map((cell) => {
            const level = levelForScore(scoreForBase(cell.base, 8));
            return <path d={cell.path} class={`hex level-${level}`} />;
          })}
        </g>
        <polygon points={outlinePoints} class="region-outline" />
        {keyPlaces.map((place) => <g class="city-label">
          <circle cx={place.x} cy={place.y - 3} r="4" />
          <text x={place.x + 9} y={place.y + 1}>{place.name}</text>
        </g>)}
        <text class="region-name" x="465" y="126">{regionLabel}</text>
      </svg>
    </div>
    <figcaption id="hero-visual-caption" class="figure-caption">
      <span class="figure-kicker">{figureLabel}</span>
      <span>{copy.previewCaption}</span>
      <span class="legend" aria-hidden="true">
        <i class="level-0"></i>{copy.low}
        <i class="level-2"></i>{copy.mid}
        <i class="level-4"></i>{copy.high}
      </span>
    </figcaption>
  </figure>
</section>

<style>
  .home-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(450px,.96fr);gap:64px;align-items:center;padding:70px 0 42px}
  .hero-copy{display:grid;gap:20px;align-content:center}
  .hero-copy h1{max-width:14ch;font-size:clamp(3.2rem,5.2vw,4.8rem);line-height:1.05}
  .hero-copy .lead{max-width:54ch;color:#c1ccc8;font-size:1.03rem}
  .hero-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:2px}
  .hero-actions .btn{gap:9px}

  .map-figure{margin:0;min-width:0}
  .map-frame{overflow:hidden;border:1px solid #2a443c;border-radius:8px;background:#0a1d19;box-shadow:0 18px 48px rgba(0,0,0,.16)}
  .map-frame svg{display:block;width:100%;height:auto;aspect-ratio:1.12/1}
  .map-bg{fill:#0a1d19}
  .region-fill{fill:#0d2420;stroke:#70877f;stroke-width:2}
  .region-outline{fill:none;stroke:#8fa49c;stroke-width:2.2;pointer-events:none}
  .hex{stroke:#0d2420;stroke-width:1.1;opacity:.96}
  .level-0{fill:var(--q0);background:var(--q0)}
  .level-1{fill:var(--q1);background:var(--q1)}
  .level-2{fill:var(--q2);background:var(--q2)}
  .level-3{fill:var(--q3);background:var(--q3)}
  .level-4{fill:var(--q4);background:var(--q4)}
  .city-label circle{fill:#f2f4ee;stroke:#071512;stroke-width:2}
  .city-label text{fill:#f2f4ee;stroke:#071512;stroke-width:4;paint-order:stroke;stroke-linejoin:round;font:700 14px var(--sans)}
  .region-name{fill:#a1b0aa;font:650 11px var(--mono);letter-spacing:.11em}

  .figure-caption{display:grid;grid-template-columns:auto 1fr auto;gap:7px 12px;align-items:center;padding-top:9px;color:#a8b7b1;font-size:.74rem;line-height:1.35}
  .figure-kicker{grid-column:1/-1;color:#8fa19a;font:650 .65rem var(--mono);letter-spacing:.08em;text-transform:uppercase}
  .legend{display:inline-flex;align-items:center;justify-content:flex-end;gap:5px;white-space:nowrap}
  .legend i{width:11px;height:11px;border-radius:2px;margin-left:5px}

  @media(max-width:1100px){
    .home-hero{grid-template-columns:minmax(0,1fr) 430px;gap:38px}.hero-copy h1{font-size:clamp(3rem,5vw,4.2rem)}
  }
  @media(max-width:820px){
    .home-hero{grid-template-columns:1fr;gap:34px;padding-top:44px}.hero-copy h1{max-width:15ch;font-size:clamp(3rem,10.5vw,4.7rem)}.map-figure{max-width:650px}
  }
  @media(max-width:600px){
    .home-hero{padding-top:30px}.hero-copy{gap:16px}.hero-copy h1{font-size:clamp(2.65rem,12vw,3.65rem)}
    .figure-caption{grid-template-columns:1fr}.legend{justify-content:flex-start}.map-frame svg{aspect-ratio:1/1}
  }
</style>
