---
import { homeContent, type HomeLocale } from "../../data/home";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = homeContent[locale].hero;

// A conceptual illustration only; geographic H-MIP estimates will use reviewed data later.
const marks = [
  [86, 91, 1], [158, 70, 0], [241, 85, 2], [316, 56, 1], [405, 80, 0], [510, 64, 1],
  [62, 177, 0], [144, 165, 2], [223, 160, 3], [310, 146, 2], [387, 170, 4], [487, 150, 3],
  [98, 261, 1], [177, 246, 3], [263, 261, 4], [351, 240, 3], [438, 262, 2], [535, 234, 1],
  [58, 337, 0], [145, 333, 1], [231, 333, 2], [318, 320, 1], [413, 342, 2], [500, 322, 0],
] as const;
const colors = ["var(--q0)", "var(--q1)", "var(--q2)", "var(--q3)", "var(--q4)"];
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="hero-copy">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="home-title">{copy.title}</h1>
    <p class="lead">{copy.lead}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#explore">{copy.primary} <span aria-hidden="true">→</span></a>
      <a class="btn btn-secondary" href="#findings">{copy.secondary}</a>
    </div>
    <dl class="hero-context">
      {copy.context.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl>
  </div>

  <figure class="visual-plate" aria-labelledby="hero-visual-caption">
    <div class="plate-head"><strong>{copy.previewTitle}</strong><span class="demo-tag">{copy.previewLabel}</span></div>
    <div class="plate-art" aria-hidden="true">
      <svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice">
        <defs>
          <pattern id="preview-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="#cbdad4" stroke-width="1" /></pattern>
          <linearGradient id="preview-wash" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f1f5f2" /><stop offset="1" stop-color="#dce8e3" /></linearGradient>
        </defs>
        <rect width="600" height="400" fill="url(#preview-wash)" />
        <rect width="600" height="400" fill="url(#preview-grid)" />
        <path d="M-10 289 C110 220 159 284 263 209 S452 170 610 72" fill="none" stroke="#ffffff" stroke-width="26" opacity=".8" />
        <path d="M-10 289 C110 220 159 284 263 209 S452 170 610 72" fill="none" stroke="#b9cec5" stroke-width="2" stroke-dasharray="5 7" />
        {marks.map(([x, y, level]) => <circle cx={x} cy={y} r="20" fill={colors[level]} opacity=".88" stroke="#fff" stroke-width="3" />)}
      </svg>
    </div>
    <figcaption id="hero-visual-caption" class="plate-foot">
      <span>{copy.previewCaption}</span>
      <span class="legend" aria-hidden="true"><i class="swatch low"></i>{copy.low}<i class="swatch mid"></i>{copy.mid}<i class="swatch high"></i>{copy.high}</span>
    </figcaption>
  </figure>
</section>

<style>
  .home-hero{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(420px,.94fr);gap:54px;align-items:center;padding-top:20px}
  .hero-copy{display:grid;gap:18px}.hero-copy h1{font-size:clamp(2.85rem,5vw,4.7rem);max-width:13.5ch}.hero-copy .lead{max-width:55ch}
  .hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}
  .hero-context{display:flex;flex-wrap:wrap;gap:16px 26px;padding-top:12px;margin:0;border-top:1px solid var(--line);font-size:.83rem}
  .hero-context div{display:flex;gap:6px}.hero-context dt{color:var(--ink-3);font-weight:700}.hero-context dd{margin:0;color:var(--ink)}
  .visual-plate{margin:0;background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden;min-width:0}
  .plate-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 15px;border-bottom:1px solid var(--line);font-size:.82rem}
  .plate-head strong{font:650 1.04rem var(--serif)}
  .plate-art{height:430px;background:#e3ebe8}.plate-art svg{display:block;width:100%;height:100%}
  .plate-foot{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;padding:12px 15px;border-top:1px solid var(--line);font-size:.78rem;color:var(--ink-3)}
  .legend{display:inline-flex;align-items:center;gap:5px;white-space:nowrap}.swatch{width:12px;height:12px;border:1px solid #adc0b8;border-radius:3px;margin-left:6px}.low{background:var(--q0)}.mid{background:var(--q2)}.high{background:var(--q4)}
  @media(max-width:1100px){.home-hero{grid-template-columns:1fr 420px;gap:32px}}
  @media(max-width:820px){.home-hero{grid-template-columns:1fr;gap:28px}.hero-copy h1{max-width:14ch;font-size:clamp(3rem,11vw,5rem)}.plate-art{height:390px}}
  @media(max-width:600px){.home-hero{padding-top:4px}.plate-art{height:300px}.plate-foot{align-items:flex-start}}
</style>
