---
import { homeContent, type HomeLocale } from "../../data/home";
import { finding } from "../../data/findings";
import { hourlyPattern, monthlyPattern } from "../../data/temporal";
import { activityRows } from "../../data/activityResearch";
import { routes } from "../../utils/urls";
import SurveyDemoNotice from "../editorial/SurveyDemoNotice.astro";
import { surveyBadge } from "../../data/surveyPreview";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = homeContent[locale].findings;
const badge = surveyBadge(locale, copy.badge);
const number = new Intl.NumberFormat({ en: "en-GB", es: "es-ES", ca: "ca-ES" }[locale], { maximumFractionDigits: 1 });
const monthNames = Array.from({ length: 12 }, (_, index) => new Intl.DateTimeFormat({ en: "en-GB", es: "es-ES", ca: "ca-ES" }[locale], { month: "long" }).format(new Date(2025, index, 1)));
const chartData = {
  hour: hourlyPattern.map((row, index) => ({ label: `${String(index).padStart(2, "0")}:00`, value: row.share })),
  month: monthlyPattern.map((row, index) => ({ label: monthNames[index], value: row.share })),
  place: activityRows("place_type", "all", locale).map((row) => ({ label: row.label, value: row.share })),
  activity: activityRows("activity", "all", locale).map((row) => ({ label: row.label, value: row.share })),
};
---

<section class="findings-section" id="findings" aria-labelledby="findings-title">
  <div class="findings-head"><div><p class="eyebrow">{copy.eyebrow}</p><h2 id="findings-title">{copy.title}</h2></div><span class="demo-tag">{badge}</span></div>
  <SurveyDemoNotice locale={locale} />
  <div class="findings">
    {copy.items.map((item) => {
      const data = chartData[item.chart];
      const max = Math.max(...data.map((point) => point.value));
      const record = finding(item.id, locale);
      const href = record.linkPage === "when" ? routes[locale].when : routes[locale].activities;
      return <article class="finding">
        <p class="eyebrow">{item.label}</p>
        <p class="finding-value">{number.format(record.value)}{locale === "en" ? "" : " "}{record.unit}</p>
        <p class="finding-text">{record.text}</p>
        <div class={`spark spark-${item.chart}`} role="group" aria-label={item.label} data-tooltip-group>
          {data.map((point, index) => <i style={`height:${Math.max(12, point.value / max * 100)}%`} tabindex={index === 0 ? "0" : "-1"} role="img" aria-label={`${point.label}: ${number.format(point.value * 100)}% · ${badge}`} data-tooltip={`${point.label}: ${number.format(point.value * 100)}% · ${badge}`}></i>)}
        </div>
        <p class="chart-note">{copy.chartDescription} · <a href={href}>{item.label} →</a></p>
      </article>;
    })}
  </div>
</section>

<style>
  .findings-section{margin-top:64px;scroll-margin-top:calc(var(--header-height) + 20px)}
  .findings-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:14px}.findings-head h2{font-size:clamp(1.65rem,2.7vw,2.45rem);margin-top:7px}
  .findings{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:2px solid var(--ink)}
  .finding{padding:22px 20px 22px 0;display:grid;gap:9px;grid-template-rows:auto auto 1fr auto auto;min-width:0}.finding+.finding{padding-left:20px;border-left:1px solid var(--line)}
  .finding-value{font:650 clamp(2rem,4vw,3.35rem)/1 var(--serif);letter-spacing:-.03em}.finding-text{color:var(--ink-2);font-size:.93rem}
  .spark{display:flex;align-items:end;gap:2px;height:66px;overflow:visible}.spark i{flex:1;min-width:2px;background:var(--teal);opacity:.8;border-radius:2px 2px 0 0}.spark i:hover,.spark i:focus{opacity:1;outline:2px solid var(--ink);outline-offset:1px}.spark-month i{background:var(--q2)}.spark-place i{background:var(--q3)}.spark-activity i{background:var(--q4)}
  .chart-note{font-size:.72rem;color:var(--ink-3);line-height:1.35}
  @media(max-width:1100px){.findings{grid-template-columns:repeat(2,1fr)}.finding:nth-child(3){padding-left:0;border-left:0;border-top:1px solid var(--line)}.finding:nth-child(4){border-top:1px solid var(--line)}}
  @media(max-width:600px){.findings-head{align-items:start}.findings{grid-template-columns:1fr}.finding+.finding{padding-left:0;border-left:0;border-top:1px solid var(--line)}.finding{min-height:215px}}
</style>
