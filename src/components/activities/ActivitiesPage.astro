---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RankedShare from "./RankedShare.astro";
import type { HomeLocale } from "../../data/home";
import { activitiesContent, categoryLabels, demoActivityShares, demoPlaceShares } from "../../data/activities";

interface Props { locale: HomeLocale }
const { locale } = Astro.props;
const copy = activitiesContent[locale];
const labels = categoryLabels[locale];
---

<BaseLayout locale={locale} title={copy.metaTitle} description={copy.metaDescription}>
  <div class="wrap page activities-page">
    <header class="page-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      <span class="demo-tag">{copy.badge}</span>
      <p class="source-note">{copy.sourceNote}</p>
    </header>
    <div class="story-layout">
      <RankedShare locale={locale} id="activities" copy={copy.activity} labels={labels.activities} values={demoActivityShares} measure={copy.measure} badge={copy.badge} methodSummary={copy.methodSummary} tableValue={copy.tableValue} />
      <RankedShare locale={locale} id="places" copy={copy.place} labels={labels.places} values={demoPlaceShares} measure={copy.measure} badge={copy.badge} methodSummary={copy.methodSummary} tableValue={copy.tableValue} />
    </div>
  </div>
</BaseLayout>

<style>
  .page-head{display:grid;justify-items:start;gap:14px;max-width:850px;margin-bottom:42px}.page-head h1{font-size:clamp(2.55rem,4.7vw,4.55rem)}.source-note{color:var(--ink-3);font-size:.84rem}.story-layout{display:grid;gap:72px}
  @media(max-width:600px){.story-layout{gap:56px}.page-head h1{font-size:clamp(2.4rem,12vw,3.5rem)}}
</style>
