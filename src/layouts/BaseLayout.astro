---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { internalUrl } from "../utils/urls";

type Locale = "en" | "es" | "ca";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const {
  locale,
  title = "H-MIP Explore",
  description = "Research on where, when and during which activities people in Catalonia are bitten by mosquitoes.",
} = Astro.props;

const skipLabel = { en: "Skip to content", es: "Saltar al contenido", ca: "Salta al contingut" }[locale];
const staging = Astro.site?.hostname === "staging.hmip-bites.pages.dev";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/x-icon" href={internalUrl("favicon.ico")} />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />
    {staging && <meta name="robots" content="noindex, nofollow" />}

    <meta name="color-scheme" content="light" />

    <meta
      name="referrer"
      content="strict-origin-when-cross-origin"
    />

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      {skipLabel}
    </a>

    <Header locale={locale} />

    <main id="main-content">
      <slot />
    </main>

    <Footer locale={locale} />
    <script src="../scripts/dataTooltips.ts"></script>
  </body>
</html>
